{
  "name": "Fechar FollowUpContador ao completar Sprint",
  "description": "Quando uma sprint \u00e9 marcada como completed, fecha o FU ativo vinculado",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ConsultoriaSprint"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fechar_followupcontador_ao_completar_sprint",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkSprintCompletion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkSprintCompletion"
  }
}