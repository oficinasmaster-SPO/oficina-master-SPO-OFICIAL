{
  "name": "Encerrar oficina ao inativar (Workshop update)",
  "description": "Quando o status do Workshop muda para 'inativo', dispara onWorkshopInactivated para limpar follow-ups pendentes/futuros e criar um follow-up de encerramento (+7 dias) atribu\u00eddo ao \u00faltimo consultor.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"inativo\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Workshop"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "encerrar_oficina_ao_inativar_workshop_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onWorkshopInactivated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onWorkshopInactivated"
  }
}