{
  "name": "Gerar bucket ao ativar plano (Workshop update)",
  "description": "Quando o plano do Workshop muda para ativo (changed_fields cont\u00e9m 'planoAtual' E planStatus='active'), dispara generateWorkshopAttendances para criar o bucket de atendimentos. Idempotente \u2014 seguro mesmo se chamado tamb\u00e9m por adminUpdateWorkshopPlan. Cobre todos os paths de ativa\u00e7\u00e3o (webhookKiwify, processPaymentWebhook, admin).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"planoAtual\") != null) and (.trigger.data.planStatus == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Workshop"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gerar_bucket_ao_ativar_plano_workshop_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateWorkshopAttendances",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateWorkshopAttendances"
  }
}