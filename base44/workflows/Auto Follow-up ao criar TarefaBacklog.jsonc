{
  "name": "Auto Follow-up ao criar TarefaBacklog",
  "description": "Cria automaticamente um FollowUpReminder quando uma TarefaBacklog \u00e9 criada, para que o CS possa acompanhar a execu\u00e7\u00e3o.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "TarefaBacklog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_follow_up_ao_criar_tarefabacklog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onTarefaBacklogCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onTarefaBacklogCreated"
  }
}