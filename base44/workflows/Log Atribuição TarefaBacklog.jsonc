{
  "name": "Log Atribui\u00e7\u00e3o TarefaBacklog",
  "description": "Registra hist\u00f3rico quando o respons\u00e1vel atribu\u00eddo \u00e9 alterado",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"atribuido_para_id\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TarefaBacklog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "log_atribui_o_tarefabacklog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logTarefaBacklogHistorico",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "logTarefaBacklogHistorico"
  }
}