{
  "name": "Encerramento ao inativar oficina",
  "description": "Remove follow-ups pendentes e futuros e cria um follow-up final sete dias ap\u00f3s a inativa\u00e7\u00e3o para o \u00faltimo consultor.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"inativo\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Workshop"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "encerramento_ao_inativar_oficina",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onWorkshopInactivated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onWorkshopInactivated"
  }
}