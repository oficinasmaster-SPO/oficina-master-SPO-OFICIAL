{
  "name": "Atualizar Taxa Realiza\u00e7\u00e3o ao Marcar Atendimento",
  "description": "Recalcula automaticamente a taxa de realiza\u00e7\u00e3o quando um atendimento \u00e9 criado ou marcado como realizado",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"realizado\") or (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ConsultoriaAtendimento"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atualizar_taxa_realiza_o_ao_marcar_atendimento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getTaxaRealizacaoClientesRelatorio",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "getTaxaRealizacaoClientesRelatorio"
  }
}