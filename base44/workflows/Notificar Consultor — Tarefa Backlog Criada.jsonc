{
  "name": "Notificar Consultor \u2014 Tarefa Backlog Criada",
  "description": "Quando uma TarefaBacklog \u00e9 criada com consultor definido, envia notifica\u00e7\u00e3o in-app + e-mail instant\u00e2neo ao consultor respons\u00e1vel",
  "trigger": {
    "condition": "${ (.trigger.data.consultor_id != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "TarefaBacklog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_consultor_tarefa_backlog_criada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarTarefaBacklog",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarTarefaBacklog"
  }
}