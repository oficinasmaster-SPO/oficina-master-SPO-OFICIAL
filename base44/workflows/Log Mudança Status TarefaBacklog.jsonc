{
  "name": "Log Mudan\u00e7a Status TarefaBacklog",
  "description": "Registra hist\u00f3rico quando o status da tarefa \u00e9 alterado",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TarefaBacklog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "log_mudan_a_status_tarefabacklog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logTarefaBacklogHistorico",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "logTarefaBacklogHistorico"
  }
}