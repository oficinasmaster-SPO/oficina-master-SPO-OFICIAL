{
  "name": "Gerar Atendimentos da Oficina",
  "description": "Gera ContractAttendances (bucket) quando uma oficina ativa o plano (planStatus muda para 'active'). Idempotente \u2014 n\u00e3o recria se j\u00e1 existem pendentes do mesmo tipo.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"planStatus\") != null) and (.trigger.data.planStatus == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Workshop"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gerar_atendimentos_da_oficina",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateWorkshopAttendances",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateWorkshopAttendances"
  }
}