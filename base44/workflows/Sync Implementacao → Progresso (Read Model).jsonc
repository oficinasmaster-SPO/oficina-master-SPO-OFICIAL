{
  "name": "Sync Implementacao \u2192 Progresso (Read Model)",
  "description": "Projeta unidirecionalmente CronogramaImplementacao para CronogramaProgresso sempre que um item \u00e9 atualizado. Mant\u00e9m o read model sincronizado sem l\u00f3gica bidirecional.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "CronogramaImplementacao"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_implementacao_progresso_read_model",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncImplementacaoToProgresso",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncImplementacaoToProgresso"
  }
}