{
  "name": "Follow-up Autom\u00e1tico P\u00f3s-Atendimento",
  "description": "Cria follow-up autom\u00e1tico 7 dias ap\u00f3s atendimento realizado/conclu\u00eddo para clientes com planos de recorr\u00eancia",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"realizado\" or .trigger.data.status == \"concluido\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ConsultoriaAtendimento"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "follow_up_autom_tico_p_s_atendimento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "criarFollowUpPosAtendimento",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "criarFollowUpPosAtendimento"
  }
}