{
  "name": "Follow-up Guarda-Chuva Semanal (Segunda 09:00)",
  "description": "Toda segunda-feira \u00e0s 09:00, varre todos workshops ativos e cria follow-up preventivo para clientes sem contato recente (sem atendimento em 30 dias, sem sprint ativa, sem FU pendente)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 12 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "follow_up_guarda_chuva_semanal_segunda_09_00",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "criarFollowUpParaClientesSemContato",
            "args": {
              "dry_run": false,
              "lookback_days": 30,
              "planos_elegiveis": [
                "BRONZE",
                "PRATA",
                "GOLD",
                "IOM",
                "MILLIONS"
              ]
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "criarFollowUpParaClientesSemContato"
  }
}