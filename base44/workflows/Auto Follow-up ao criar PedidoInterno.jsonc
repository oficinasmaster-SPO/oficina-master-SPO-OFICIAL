{
  "name": "Auto Follow-up ao criar PedidoInterno",
  "description": "Cria automaticamente um FollowUpReminder quando um PedidoInterno \u00e9 criado, para que o CS possa cobrar a resolu\u00e7\u00e3o.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "PedidoInterno"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_follow_up_ao_criar_pedidointerno",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onPedidoInternoCreated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onPedidoInternoCreated"
  }
}