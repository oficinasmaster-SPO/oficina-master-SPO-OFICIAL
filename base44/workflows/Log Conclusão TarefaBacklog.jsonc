{
  "name": "Log Conclus\u00e3o TarefaBacklog",
  "description": "Registra hist\u00f3rico de conclus\u00e3o e detecta data_conclusao quando status muda para concluida",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"concluida\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TarefaBacklog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "log_conclus_o_tarefabacklog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logTarefaBacklogHistorico",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "logTarefaBacklogHistorico"
  }
}