{
  "properties": {
    "anexos": {
      "description": "Notas fiscais, contratos e documentos anexados",
      "items": {
        "properties": {
          "extension": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "type": {
            "description": "image | document | link",
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "cnpj": {
      "description": "CNPJ do fornecedor",
      "type": "string"
    },
    "contato": {
      "description": "Nome ou telefone do contato",
      "type": "string"
    },
    "endereco_bairro": {
      "description": "Bairro",
      "type": "string"
    },
    "endereco_cep": {
      "description": "CEP do endere\u00e7o",
      "type": "string"
    },
    "endereco_cidade": {
      "description": "Cidade",
      "type": "string"
    },
    "endereco_complemento": {
      "description": "Complemento (apto, sala, etc.)",
      "type": "string"
    },
    "endereco_logradouro": {
      "description": "Rua / Avenida",
      "type": "string"
    },
    "endereco_numero": {
      "description": "N\u00famero do endere\u00e7o",
      "type": "string"
    },
    "endereco_uf": {
      "description": "Estado (UF)",
      "type": "string"
    },
    "nome": {
      "description": "Raz\u00e3o Social ou nome do fornecedor",
      "type": "string"
    },
    "numero_nfe": {
      "description": "N\u00famero da Nota Fiscal Eletr\u00f4nica",
      "type": "string"
    },
    "numero_pedido": {
      "description": "N\u00famero do pedido de compra",
      "type": "string"
    },
    "workshop_id": {
      "description": "ID da oficina criadora \u2014 isolamento multi-tenant",
      "type": "string"
    }
  },
  "required": [
    "workshop_id",
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object",
  "name": "WorkshopFornecedor"
}