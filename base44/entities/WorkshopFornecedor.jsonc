{
  "properties": {
    "anexos": {
      "description": "Arquivos anexados ao cadastro do fornecedor (NFe, PDFs, imagens)",
      "items": {
        "properties": {
          "extension": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "type": {
            "description": "image | document | link",
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "cnpj": {
      "description": "CNPJ do fornecedor",
      "type": "string"
    },
    "contato": {
      "description": "Telefone ou e-mail de contato",
      "type": "string"
    },
    "endereco_bairro": {
      "description": "Bairro",
      "type": "string"
    },
    "endereco_cep": {
      "description": "CEP",
      "type": "string"
    },
    "endereco_cidade": {
      "description": "Cidade",
      "type": "string"
    },
    "endereco_complemento": {
      "description": "Complemento",
      "type": "string"
    },
    "endereco_logradouro": {
      "description": "Rua / Avenida",
      "type": "string"
    },
    "endereco_numero": {
      "description": "N\u00famero",
      "type": "string"
    },
    "endereco_uf": {
      "description": "UF (2 letras)",
      "type": "string"
    },
    "nome": {
      "description": "Raz\u00e3o Social ou Nome do fornecedor (obrigat\u00f3rio)",
      "type": "string"
    },
    "numero_nfe": {
      "description": "N\u00famero da Nota Fiscal Eletr\u00f4nica",
      "type": "string"
    },
    "numero_pedido": {
      "description": "N\u00famero do Pedido",
      "type": "string"
    },
    "workshop_id": {
      "description": "ID da oficina propriet\u00e1ria. Isola o registro por tenant.",
      "type": "string"
    }
  },
  "required": [
    "workshop_id",
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object",
  "name": "WorkshopFornecedor"
}