{
  "name": "Diagnostic",
  "properties": {
    "answers": {
      "description": "Respostas do diagn\u00f3stico com justificativas",
      "items": {
        "properties": {
          "justificativa_audio_url": {
            "description": "URL do \u00e1udio de justificativa (opcional)",
            "type": "string"
          },
          "justificativa_texto": {
            "description": "Justificativa obrigat\u00f3ria do usu\u00e1rio",
            "type": "string"
          },
          "observacoes": {
            "description": "Observa\u00e7\u00f5es adicionais opcionais",
            "type": "string"
          },
          "question_id": {
            "type": "integer"
          },
          "selected_option": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "completed": {
      "default": false,
      "description": "Diagn\u00f3stico completo",
      "type": "boolean"
    },
    "decisions_deliberations": {
      "description": "Se\u00e7\u00e3o '03 Decis\u00f5es/Delibera\u00e7\u00f5es' da ATA",
      "properties": {
        "agreed_priorities": {
          "description": "Prioridades acordadas com o cliente",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "constraints_identified": {
          "description": "Limita\u00e7\u00f5es/restri\u00e7\u00f5es identificadas",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "next_meeting_date": {
          "format": "date",
          "type": "string"
        }
      },
      "type": "object"
    },
    "dominant_letter": {
      "description": "Letra predominante",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "type": "string"
    },
    "implementation_checklist_ids": {
      "description": "IDs das tarefas criadas no DiagnosticActionPlan",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "justifications_completed": {
      "default": false,
      "description": "Indica se todas as justificativas foram preenchidas",
      "type": "boolean"
    },
    "letter_distribution": {
      "description": "Distribui\u00e7\u00e3o de letras para an\u00e1lise secund\u00e1ria",
      "properties": {
        "A": {
          "default": 0,
          "type": "integer"
        },
        "B": {
          "default": 0,
          "type": "integer"
        },
        "C": {
          "default": 0,
          "type": "integer"
        },
        "D": {
          "default": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "phase": {
      "description": "Fase identificada",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "type": "integer"
    },
    "result_summary": {
      "description": "Se\u00e7\u00e3o '02 Resultados' da ATA",
      "properties": {
        "critical_findings": {
          "description": "3-5 descobertas cr\u00edticas",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "executive_summary": {
          "type": "string"
        },
        "phase_distribution_text": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "user_id": {
      "description": "ID do usu\u00e1rio que respondeu",
      "type": "string"
    },
    "workshop_id": {
      "description": "ID da oficina",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "answers"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        }
      ]
    }
  },
  "type": "object"
}