{
  "name": "DISCDiagnostic",
  "properties": {
    "answers": {
      "description": "Respostas do teste (1-4 para cada perfil)",
      "items": {
        "properties": {
          "c_score": {
            "type": "integer"
          },
          "d_score": {
            "type": "integer"
          },
          "i_score": {
            "type": "integer"
          },
          "question_id": {
            "type": "integer"
          },
          "s_score": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "candidate_id": {
      "description": "ID do candidato avaliado (se externo/seletivo)",
      "type": "string"
    },
    "candidate_name": {
      "description": "Nome do candidato (se externo)",
      "type": "string"
    },
    "company_id": {
      "description": "ID da empresa",
      "type": "string"
    },
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "consulting_firm_id": {
      "description": "ID da consultoria",
      "type": "string"
    },
    "dominant_profile": {
      "description": "Perfil predominante",
      "enum": [
        "executor_d",
        "comunicador_i",
        "planejador_s",
        "analista_c"
      ],
      "type": "string"
    },
    "employee_id": {
      "description": "ID do colaborador avaliado",
      "type": "string"
    },
    "evaluation_type": {
      "default": "manager",
      "description": "Tipo de avalia\u00e7\u00e3o: Gestor ou Autoavalia\u00e7\u00e3o",
      "enum": [
        "manager",
        "self"
      ],
      "type": "string"
    },
    "evaluator_id": {
      "description": "ID do avaliador (opcional se autoavalia\u00e7\u00e3o)",
      "type": "string"
    },
    "invite_id": {
      "description": "ID do convite (se originado de link)",
      "type": "string"
    },
    "is_leader": {
      "default": false,
      "description": "Se \u00e9 um l\u00edder de equipe",
      "type": "boolean"
    },
    "profile_scores": {
      "description": "Percentuais finais de cada perfil",
      "properties": {
        "analista_c": {
          "type": "number"
        },
        "comunicador_i": {
          "type": "number"
        },
        "executor_d": {
          "type": "number"
        },
        "planejador_s": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "recommended_roles": {
      "description": "Fun\u00e7\u00f5es recomendadas",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resultado_email_colaborador_enviado": {
      "default": false,
      "description": "Se o e-mail com o resultado foi enviado ao colaborador avaliado (trava antirreenvio)",
      "type": "boolean"
    },
    "resultado_email_enviado_em": {
      "description": "Data/hora do \u00faltimo e-mail de resultado enviado",
      "format": "date-time",
      "type": "string"
    },
    "resultado_email_lideranca_enviado": {
      "default": false,
      "description": "Se o e-mail com o resultado foi enviado \u00e0 lideran\u00e7a da oficina (trava antirreenvio)",
      "type": "boolean"
    },
    "team_name": {
      "description": "Nome da equipe (para compara\u00e7\u00e3o)",
      "type": "string"
    },
    "workshop_id": {
      "description": "ID da oficina",
      "type": "string"
    }
  },
  "required": [
    "workshop_id",
    "answers"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.evaluator_id": "{{user.id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "$and": [
            {
              "data.consulting_firm_id": "{{user.data.consulting_firm_id}}"
            },
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.company_id": "{{user.data.company_id}}"
            },
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.evaluator_id": "{{user.id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        }
      ]
    }
  },
  "type": "object"
}