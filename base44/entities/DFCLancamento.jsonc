{
  "name": "DFCLancamento",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "description": "ID da oficina"
    },
    "mes": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia no formato YYYY-MM (ex: 2026-05)"
    },
    "liquidacao_financeira_id": {
      "type": "string",
      "description": "ID da LiquidacaoFinanceira que gerou este lan\u00e7amento. Usado pelo estorno (desfazerLiquidacao) para localizar e deletar o DFC \u2014 sem ele o lan\u00e7amento fica \u00f3rf\u00e3o no caixa."
    },
    "transferencia_id": {
      "type": "string",
      "description": "ID \u00fanico que amarra o par de lan\u00e7amentos (sa\u00edda + entrada) de uma transfer\u00eancia entre contas (grupo=transferencia). Usado pelo estorno (desfazerTransferencia) para localizar e reverter o par completo \u2014 sem ele o estorno n\u00e3o consegue garantir a revers\u00e3o dos dois lados."
    },
    "grupo": {
      "type": "string",
      "enum": [
        "operacional",
        "investimento",
        "financiamento",
        "saldo_inicial",
        "transferencia"
      ],
      "description": "Grupo do fluxo de caixa. 'transferencia' = movimenta\u00e7\u00e3o entre contas da pr\u00f3pria oficina (n\u00e3o altera o resultado do m\u00eas nem o saldo total \u2014 apenas a distribui\u00e7\u00e3o entre contas)."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Se \u00e9 uma entrada ou sa\u00edda de caixa. Em transfer\u00eancias: 'saida' = sai da conta de origem, 'entrada' = chega na conta de destino."
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "valor": {
      "type": "number",
      "description": "Valor em reais"
    },
    "origem": {
      "type": "string",
      "enum": [
        "manual",
        "dre_automatico",
        "liquidacao_financeira",
        "transferencia"
      ],
      "default": "manual",
      "description": "Se foi inserido manualmente, mapeado do DRE, gerado por uma liquida\u00e7\u00e3o financeira ou gerado por uma transfer\u00eancia entre contas"
    },
    "saldo_inicial": {
      "type": "number",
      "description": "Saldo inicial do m\u00eas. Usado apenas no registro de controle (grupo=saldo_inicial)."
    },
    "detalhes": {
      "type": "object",
      "description": "Detalhamento de onde est\u00e1 o dinheiro do saldo inicial (apenas para grupo=saldo_inicial)",
      "properties": {
        "banco": {
          "type": "number",
          "description": "[LEGADO] Valor em conta banc\u00e1ria"
        },
        "maquina_cartao": {
          "type": "number",
          "description": "[LEGADO] Valor em receb\u00edveis de m\u00e1quina de cart\u00e3o"
        },
        "caixa": {
          "type": "number",
          "description": "Valor em dinheiro f\u00edsico"
        },
        "bancos": {
          "type": "array",
          "description": "Lista de contas banc\u00e1rias detalhadas",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "tipo_conta": {
                "type": "string"
              },
              "saldo": {
                "type": "number"
              },
              "data": {
                "type": "string"
              }
            }
          }
        },
        "maquinas_cartao": {
          "type": "array",
          "description": "Lista de m\u00e1quinas de cart\u00e3o detalhadas",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "gateway_pagamento": {
                "type": "string"
              },
              "saldo": {
                "type": "number"
              },
              "data": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "fonte_saida": {
      "type": "string",
      "enum": [
        "banco",
        "maquina_cartao",
        "caixa"
      ],
      "description": "De onde saiu o dinheiro para este lan\u00e7amento de sa\u00edda"
    },
    "fonte_entrada": {
      "type": "string",
      "description": "Conta de destino de uma transfer\u00eancia entre contas (chave 'banco:<id>:<nome>', 'maquina:<id>:<nome>' ou 'caixa:caixa:Caixa' \u2014 mesmo formato de fonte_saida). Apenas para grupo=transferencia, tipo=entrada."
    }
  },
  "required": [
    "workshop_id",
    "mes",
    "grupo",
    "tipo",
    "valor"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    }
  }
}