{
  "name": "DFCLancamento",
  "type": "object",
  "properties": {
    "workshop_id": {
      "type": "string",
      "description": "ID da oficina"
    },
    "mes": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia no formato YYYY-MM (ex: 2026-05)"
    },
    "liquidacao_financeira_id": {
      "type": "string",
      "description": "ID da LiquidacaoFinanceira que gerou este lan\u00e7amento. Usado pelo estorno (desfazerLiquidacao) para localizar e deletar o DFC \u2014 sem ele o lan\u00e7amento fica \u00f3rf\u00e3o no caixa."
    },
    "grupo": {
      "type": "string",
      "enum": [
        "operacional",
        "investimento",
        "financiamento",
        "saldo_inicial"
      ],
      "description": "Grupo do fluxo de caixa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Se \u00e9 uma entrada ou sa\u00edda de caixa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "valor": {
      "type": "number",
      "description": "Valor em reais"
    },
    "origem": {
      "type": "string",
      "enum": [
        "manual",
        "dre_automatico",
        "liquidacao_financeira"
      ],
      "default": "manual",
      "description": "Se foi inserido manualmente, mapeado do DRE ou gerado por uma liquida\u00e7\u00e3o financeira"
    },
    "saldo_inicial": {
      "type": "number",
      "description": "Saldo inicial do m\u00eas. Usado apenas no registro de controle (grupo=saldo_inicial)."
    },
    "detalhes": {
      "type": "object",
      "description": "Detalhamento de onde est\u00e1 o dinheiro do saldo inicial (apenas para grupo=saldo_inicial)",
      "properties": {
        "banco": {
          "type": "number",
          "description": "[LEGADO] Valor em conta banc\u00e1ria"
        },
        "maquina_cartao": {
          "type": "number",
          "description": "[LEGADO] Valor em receb\u00edveis de m\u00e1quina de cart\u00e3o"
        },
        "caixa": {
          "type": "number",
          "description": "Valor em dinheiro f\u00edsico"
        },
        "bancos": {
          "type": "array",
          "description": "Lista de contas banc\u00e1rias detalhadas",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "tipo_conta": {
                "type": "string"
              },
              "saldo": {
                "type": "number"
              },
              "data": {
                "type": "string"
              }
            }
          }
        },
        "maquinas_cartao": {
          "type": "array",
          "description": "Lista de m\u00e1quinas de cart\u00e3o detalhadas",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "nome": {
                "type": "string"
              },
              "gateway_pagamento": {
                "type": "string"
              },
              "saldo": {
                "type": "number"
              },
              "data": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "fonte_saida": {
      "type": "string",
      "enum": [
        "banco",
        "maquina_cartao",
        "caixa"
      ],
      "description": "De onde saiu o dinheiro para este lan\u00e7amento de sa\u00edda"
    }
  },
  "required": [
    "workshop_id",
    "mes",
    "grupo",
    "tipo",
    "valor"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    }
  }
}