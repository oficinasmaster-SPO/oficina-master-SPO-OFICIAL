{
  "properties": {
    "categoria": {
      "description": "Categoria do lan\u00e7amento",
      "type": "string"
    },
    "cliente_id": {
      "description": "ID do WorkshopCliente vinculado (apenas receitas)",
      "type": "string"
    },
    "cliente_nome": {
      "description": "Nome do cliente \u2014 desnormalizado para exibi\u00e7\u00e3o r\u00e1pida",
      "type": "string"
    },
    "data_fim": {
      "description": "Data de fim da recorr\u00eancia",
      "format": "date",
      "type": "string"
    },
    "data_inicio": {
      "description": "Data de in\u00edcio da recorr\u00eancia",
      "format": "date",
      "type": "string"
    },
    "data_pagamento": {
      "description": "Data em que o pagamento/recebimento foi efetivado no caixa. Vazio = pendente no DFC.",
      "format": "date",
      "type": "string"
    },
    "data_vencimento": {
      "description": "Data de vencimento da obriga\u00e7\u00e3o (ex: boleto, fatura). Usado no DFC para proje\u00e7\u00e3o.",
      "format": "date",
      "type": "string"
    },
    "descricao": {
      "description": "Descri\u00e7\u00e3o livre do lan\u00e7amento",
      "type": "string"
    },
    "entra_tcmp2": {
      "default": true,
      "description": "Se este lan\u00e7amento entra no c\u00e1lculo do TCMP\u00b2. Autom\u00e1tico pela categoria.",
      "type": "boolean"
    },
    "fornecedor_id": {
      "description": "ID do WorkshopFornecedor vinculado (apenas despesas)",
      "type": "string"
    },
    "fornecedor_nome": {
      "description": "Nome do fornecedor \u2014 desnormalizado para exibi\u00e7\u00e3o r\u00e1pida",
      "type": "string"
    },
    "frequencia": {
      "default": "unico",
      "description": "Frequ\u00eancia de repeti\u00e7\u00e3o do lan\u00e7amento",
      "enum": [
        "unico",
        "mensal",
        "quinzenal",
        "semanal",
        "anual"
      ],
      "type": "string"
    },
    "mes": {
      "description": "M\u00eas de refer\u00eancia no formato YYYY-MM (ex: 2026-05)",
      "type": "string"
    },
    "numero_parcelas": {
      "description": "N\u00famero total de parcelas/repeti\u00e7\u00f5es",
      "type": "integer"
    },
    "parcela_atual": {
      "description": "N\u00famero da parcela atual (1, 2, 3...)",
      "type": "integer"
    },
    "recorrencia_id": {
      "description": "ID \u00fanico que agrupa lan\u00e7amentos recorrentes da mesma s\u00e9rie",
      "type": "string"
    },
    "subcategoria": {
      "description": "Subcategoria espec\u00edfica dentro da categoria",
      "type": "string"
    },
    "tipo": {
      "description": "Se \u00e9 uma entrada ou sa\u00edda",
      "enum": [
        "receita",
        "despesa"
      ],
      "type": "string"
    },
    "valor": {
      "description": "Valor em reais",
      "type": "number"
    },
    "workshop_id": {
      "description": "ID da oficina",
      "type": "string"
    }
  },
  "required": [
    "workshop_id",
    "mes",
    "tipo",
    "categoria",
    "valor"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.workshop_id": "{{user.tenant_workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.data.workshop_id}}"
        },
        {
          "data.workshop_id": "{{user.workshop_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data": {
              "user_type": "internal"
            }
          }
        }
      ]
    }
  },
  "name": "DRELancamento"
}